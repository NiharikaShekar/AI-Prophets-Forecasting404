# OpenRouter — required (all LLM calls go through here)
OPENROUTER_API_KEY=sk-or-...

# Brave Search — required for web evidence gathering
BRAVE_API_KEY=BSA...

# Model config — override if you want different OpenRouter models
MODEL_A=deepseek/deepseek-r1
MODEL_B=anthropic/claude-sonnet-4-5

# Prophet Arena — organizers distribute this during evaluation window
# PA_SERVER_API_KEY=prophet_...
# PA_TEAM_NAME=AI-Prophets-Forecasting404

# Kalshi — NOT needed (public API, no auth required)
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_B64=
