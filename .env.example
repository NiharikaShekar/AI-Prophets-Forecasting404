# OpenRouter — required (all LLM calls go through here)
OPENROUTER_API_KEY=sk-or-...

# Tavily Search — required (always called for web evidence)
TAVILY_API_KEY=tvly-...

# Model config — override to change OpenRouter models
MODEL_A=deepseek/deepseek-r1
MODEL_B=anthropic/claude-sonnet-4-5
MODEL_JUDGE=anthropic/claude-sonnet-4-5

# ── Domain API keys (optional — each degrades gracefully if absent) ────────

# Sports: The Odds API — https://the-odds-api.com (500 free credits/month)
ODDS_API_KEY=

# Crypto: CoinGecko demo key — https://coingecko.com/api (30 req/min free)
# Fear & Greed (alternative.me) needs no key
COINGECKO_API_KEY=

# Economics / Commodities / Financials: FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Elections / Politics: Polymarket — no key needed (public gamma API)

# Mentions / Culture: Reddit OAuth — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Climate: NOAA CDO API — https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# Culture: TMDB — https://developer.themoviedb.org (free, bearer token)
TMDB_API_KEY=

# Companies: SEC EDGAR — no key needed (public API, User-Agent only)

# Prophet Arena — organizers distribute during evaluation window
# PA_SERVER_API_KEY=prophet_...
# PA_TEAM_NAME=AI-Prophets-Forecasting404
